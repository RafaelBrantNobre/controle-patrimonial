# Modelo das variáveis de ambiente do back-end.
# Copie este arquivo para .env e preencha o que estiver vazio.
# O arquivo .env nunca vai para o Git.

APP_NAME="Controle Patrimonial"
APP_ENV=local
# Gerada pelo comando: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Fuso horário usado nas datas gravadas no banco.
APP_TIMEZONE=America/Sao_Paulo

# Endereço do front-end, liberado para chamar a API (CORS).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (MySQL no Docker, ver docker-compose.yml).
# O docker compose lê estes mesmos valores para criar o banco.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=controle_patrimonial
DB_USERNAME=patrimonio
# Escolha uma senha qualquer para o seu banco local e escreva aqui.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"
