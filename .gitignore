# Regras gerais do repositório.
# Cada projeto tem o próprio .gitignore: backend/.gitignore e frontend/.gitignore.

# Variáveis de ambiente: só o modelo (.env.example) é versionado
.env
.env.*
!.env.example
.gitignore

# Sistema operacional e editores
.DS_Store
Thumbs.db
/.idea
/.vscode
*.log

# Dependências, caso alguém instale na raiz por engano
/vendor
/node_modules
README.md
php
